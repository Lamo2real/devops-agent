# =============================================================================
# AWS DevOps Agent template: project configuration
#
# 1. Copy this file:   cp project.env.example project.env
# 2. Fill in the values below.
# 3. Commit project.env in YOUR fork (it must not contain secrets; the
#    validator refuses anything that looks like a token or a key).
# 4. Deploy:           make deploy        (or push to main with CI enabled)
#
# Format: KEY=value, one per line. Lists are comma separated. No quotes needed.
# Secrets (GitHub token, etc.) are passed as environment variables or GitHub
# Actions secrets, never in this file. See README.md, section "Secrets".
# =============================================================================

# --- Project and AWS account -------------------------------------------------
# Short lowercase name, used as a prefix for every resource (a-z, 0-9, -).
# PROJECT_NAME-ENVIRONMENT must be 36 characters or less.
PROJECT_NAME=acme-orders
# Customer / company name shown in tags and descriptions.
CUSTOMER_NAME=Acme AB
# The monitoring account where the Agent Space lives (12 digits).
AWS_ACCOUNT_ID=123456789012
# Stockholm for Swedish customers. Frankfurt (eu-central-1) or Ireland
# (eu-west-1) as alternatives. Agent Spaces in EU regions keep inference in the EU.
AWS_REGION=eu-north-1
# Environment label, used in names and tags (e.g. prod, nonprod, pilot).
ENVIRONMENT=pilot

# --- Terraform state (created by `make bootstrap`) ---------------------------
# S3 bucket for Terraform state. Leave empty to use the default name:
# <PROJECT_NAME>-tfstate-<AWS_ACCOUNT_ID>
TF_STATE_BUCKET=

# --- GitHub Actions deploy (OIDC) ---------------------------------------------
# The fork that deploys this template, as owner/repo. Used by `make bootstrap`
# to create the OIDC deploy role that GitHub Actions assumes.
DEPLOY_GITHUB_REPOSITORY=acme-ab/devops-agent
# Branch allowed to deploy. scripts/github_setup.sh limits the GitHub
# environment named ENVIRONMENT to this branch; the AWS deploy role trusts only
# that environment. Pull requests can only plan.
DEPLOY_GITHUB_BRANCH=main
# Optional: prefix of the GitHub OIDC "sub" claim. Leave empty: `make bootstrap`
# asks GitHub (gh CLI). Repositories with immutable subject claims use
# repo:<owner>@<owner id>/<repo>@<repo id>; otherwise repo:<owner>/<repo>.
DEPLOY_GITHUB_OIDC_SUB_PREFIX=
# true: create the GitHub OIDC provider in the account.
# false: reuse an existing one (an account can only have one per URL).
CREATE_GITHUB_OIDC_PROVIDER=true

# --- Agent Space -------------------------------------------------------------
# Description shown in the console. Defaults to "<CUSTOMER_NAME> <PROJECT_NAME>".
AGENT_SPACE_DESCRIPTION=
# How operators sign in to the web app: iam | idc
#   iam: console link through IAM (simplest for a pilot)
#   idc: IAM Identity Center (recommended, supports Entra ID / Okta with MFA)
OPERATOR_AUTH=iam
# Required when OPERATOR_AUTH=idc, e.g. arn:aws:sso:::instance/ssoins-1234567890abcdef
IDC_INSTANCE_ARN=
# Directed actions (agent may change AWS resources after operator approval).
# Keep false for the pilot: investigations are read only.
DIRECTED_ACTIONS_ENABLED=false
# Language of agent answers, BCP 47 (e.g. sv-SE, en-US). Empty = service default.
AGENT_LOCALE=

# --- GitHub repositories (optional) --------------------------------------------
# off   : no GitHub access
# app   : reuse a GitHub registration done once in the console (GitHub App,
#         recommended: webhooks, deploy events). Set GITHUB_SERVICE_ID or leave
#         it empty to look it up by GITHUB_OWNER.
# token : register GitHub with a personal access token through Terraform.
#         Provide the token as env var / CI secret DEVOPS_AGENT_GITHUB_TOKEN.
GITHUB_MODE=off
# GitHub organization or user that owns the repositories.
GITHUB_OWNER=acme-ab
# organization | user
GITHUB_OWNER_TYPE=organization
# Repositories the agent may read, comma separated, without the owner.
# The numeric repository id is looked up at deploy time. For private repos
# without a token, write name:id (find it with: gh api repos/OWNER/REPO --jq .id).
GITHUB_REPOS=orders-service,platform-infra
# Optional: service id of an existing GitHub registration (GITHUB_MODE=app).
GITHUB_SERVICE_ID=

# --- Alarms that start investigations ----------------------------------------
# Only symptom alarms (user impact, flap-safe) should start investigations.
# Any CloudWatch alarm whose NAME starts with one of these prefixes starts an
# investigation when it goes to ALARM. Comma separated.
ALARM_NAME_PREFIXES=symptom-
# Do not start a new investigation for the same alarm while one started within
# this many minutes is still open.
DEDUP_WINDOW_MINUTES=60
# Investigation priority: CRITICAL | HIGH | MEDIUM | LOW | MINIMAL
INVESTIGATION_PRIORITY=HIGH
# Reserved concurrency for the alarm Lambda. 0 = none (works on every account).
# A value N needs an account Lambda concurrency quota of at least 10 + N.
ALARM_TRIGGER_RESERVED_CONCURRENCY=0
# Create a test alarm (<first prefix><PROJECT_NAME>-<ENVIRONMENT>-smoke-test)
# used by `make smoke-test`. Costs ~USD 0.10/month.
CREATE_SMOKE_TEST_ALARM=true

# --- Notifications and cost control ------------------------------------------
# E-mail for alerts (usage over budget, failed triggers). Optional.
# Each recipient must confirm the SNS subscription e-mail.
ALERT_EMAILS=
# Monthly investigation hours that trigger an alert (USD ~30/agent hour).
MONTHLY_INVESTIGATION_HOURS_ALERT=20

# --- Kubernetes (optional) ----------------------------------------------------
# EKS clusters the agent may read (AmazonEKSViewPolicy, no Secrets). The clusters
# must use access entries (authentication mode API or API_AND_CONFIG_MAP).
EKS_CLUSTER_NAMES=

# --- Extra AWS accounts (optional) -------------------------------------------
# Roles in other accounts that trust this Agent Space, comma separated.
# Create them with terraform/modules/secondary-account-role in each account.
SOURCE_ACCOUNT_ROLE_ARNS=

# --- Knowledge ---------------------------------------------------------------
# Upload every knowledge/skills/<name>/SKILL.md as an agent skill.
SKILLS_ENABLED=true
# Weekly operations report (custom agent + time based trigger).
WEEKLY_REPORT_ENABLED=false
